# Copy this file to .env and fill in your own local development values.
APP_NAME=GAME NEXUS API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/gamenexus
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
SESSION_SECRET=replace-with-another-long-random-secret

# Razorpay TEST keys only while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=
